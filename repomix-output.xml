    public ResponseEntity<ChannelMessage> sendMessage(
            @PathVariable Long channelId,
            @RequestBody MessageRequest request,
            Principal principal) {
        return ResponseEntity.ok(messageService.sendMessage(channelId, request.getContent(), principal.getName()));
    }
}
